<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <!-- Solid red base with transparency -->
    <solid android:color="#30FF0000" />

    <!-- Glow effect with multiple layers -->
    <gradient
        android:type="radial"
        android:gradientRadius="100%"
        android:centerX="0.5"
        android:centerY="0.5"
        android:startColor="#60FF5252"
        android:centerColor="#30FF0000"
        android:endColor="#00FFFFFF" />

</shape>