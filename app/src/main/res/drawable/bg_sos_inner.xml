<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <!-- Emergency red gradient -->
    <gradient
        android:type="radial"
        android:gradientRadius="100%"
        android:centerX="0.5"
        android:centerY="0.5"
        android:startColor="#FF0000"
        android:centerColor="#CC0000"
        android:endColor="#990000" />

    <!-- Inner shadow -->
    <stroke
        android:width="2dp"
        android:color="#660000" />

</shape>