<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Headline: app name, big titles -->
    <style name="TextAppearance.SilentGuardian.Headline" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textColor">@color/textPrimary</item>
    </style>

    <!-- Status card titles: "GPS Status: Ready" -->
    <style name="TextAppearance.SilentGuardian.StatusTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textColor">@color/textPrimary</item>
    </style>

    <!-- Body text: descriptions, help text -->
    <style name="TextAppearance.SilentGuardian.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="fontFamily">@font/roboto_regular</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:textColor">@color/textSecondary</item>
    </style>

    <!-- Bottom navigation labels -->
    <style name="TextAppearance.SilentGuardian.BottomNav" parent="TextAppearance.MaterialComponents.Caption">
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <!-- Primary button style -->
    <style name="Widget.SilentGuardian.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/textOnPrimary</item>
    </style>

    <!-- Title Style -->
    <style name="TextAppearance.SilentGuardian.Title" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Subtitle Style -->
    <style name="TextAppearance.SilentGuardian.Subtitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- Caption Style -->
    <style name="TextAppearance.SilentGuardian.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

</resources>
