<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_dialog_rounded">

    <!-- Emergency Icon -->
    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:src="@drawable/ic_emergency_24dp"
        android:contentDescription="Emergency alert"
        app:tint="@color/colorPrimary" />

    <!-- Title -->
    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🚨 EMERGENCY ALERT"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="@color/colorPrimary"
        android:layout_marginBottom="8dp" />

    <!-- Message -->
    <TextView
        android:id="@+id/dialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Are you sure you want to trigger emergency alert?"
        android:textSize="16sp"
        android:gravity="center"
        android:textColor="@color/textPrimary"
        android:layout_marginBottom="16dp" />

    <!-- Countdown Display -->
    <TextView
        android:id="@+id/dialogCountdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sending in: 5 seconds..."
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="@color/colorAccent"
        android:layout_marginBottom="16dp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/dividerColor"
        android:layout_marginVertical="8dp" />

    <!-- What will happen -->
    <TextView
        android:id="@+id/dialogDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="This will:\n• Send SMS to 3 contacts\n• Share your location\n• Activate emergency mode"
        android:textSize="14sp"
        android:textColor="@color/textSecondary"
        android:layout_marginBottom="24dp" />

    <!-- Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="2">

        <!-- Cancel Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="CANCEL"
            android:textAllCaps="true" />

        <!-- Send Now Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendNow"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="SEND NOW"
            android:textAllCaps="true" />

    </LinearLayout>

</LinearLayout>